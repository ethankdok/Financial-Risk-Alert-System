# Shared
APP_ENV=development
GOOGLE_CLOUD_PROJECT=

# Flask web service
SECRET_KEY=
FLASK_DATASTORE_BACKEND=sqlite
FLASK_DATABASE_PATH=financial_risk.db
ALLOW_DEMO_SEED_DATA=true
FINTRUST_API_BASE_URL=http://127.0.0.1:8000
FINTRUST_INGESTION_TOKEN=
DATA_SHIFT_PARQUET=

# Member authentication
MEMBER_ALLOW_LOCAL_PASSWORD_AUTH=true
FIREBASE_PROJECT_ID=

# FastAPI financial service
DATASTORE_BACKEND=sqlite
FINANCIAL_DATABASE_PATH=./fintrust_backend/data/financial_pipeline.sqlite3
FINANCIAL_FACT_DATABASE_PATH=./fintrust_backend/data/financial_facts.sqlite3
INGESTION_API_TOKEN=
GEMINI_API_KEY=
FINANCIAL_LLM_PROVIDER=gemini
FINANCIAL_LLM_MODEL=
FINANCIAL_AI_AUTO_LLM_ENABLED=true
FINANCIAL_REFRESH_TICKERS=2330,2454
CORS_ALLOW_ORIGINS=http://localhost:5001,http://127.0.0.1:5001

# Notification processing
NOTIFICATION_JOB_TOKEN=
EMAIL_PROVIDER=console
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

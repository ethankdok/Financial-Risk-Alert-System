FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY app.py financial_routes.py company_directory.py research_routes.py integrity_routes.py b2b_routes.py fintrust_client.py flask_data_repository.py member_services.py data_shift.py ./
COPY *.html *.js *.css ./
# Explicit public MOPS snapshot; do not copy unrelated JSON or private data.
COPY ft-mops-data.json ./
COPY static ./static
COPY templates ./templates
RUN mkdir -p /app/data

CMD ["sh", "-c", "exec gunicorn --bind 0.0.0.0:${PORT:-8080} --workers 1 --threads 8 --timeout 120 --access-logfile - --error-logfile - app:app"]

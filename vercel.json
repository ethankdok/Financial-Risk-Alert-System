{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://financial-risk-web-v53gsmuxdq-de.a.run.app/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://financial-risk-web-v53gsmuxdq-de.a.run.app/health"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        }
      ]
    }
  ]
}

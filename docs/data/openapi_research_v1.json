{
  "components": {
    "schemas": {
      "ComputeRequest": {
        "properties": {
          "analysis_mode": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Required; no default",
            "title": "Analysis Mode"
          },
          "cutoff_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cutoff At"
          },
          "end_year": {
            "anyOf": [
              {
                "maximum": 2100.0,
                "minimum": 1990.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "End Year"
          },
          "persist": {
            "default": false,
            "title": "Persist",
            "type": "boolean"
          },
          "start_year": {
            "anyOf": [
              {
                "maximum": 2100.0,
                "minimum": 1990.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start Year"
          },
          "supersedes_run_id": {
            "anyOf": [
              {
                "pattern": "^rrun1_[0-9a-f]{32}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Supersedes Run Id"
          },
          "ticker": {
            "pattern": "^\\d{4,6}$",
            "title": "Ticker",
            "type": "string"
          },
          "version_policy": {
            "anyOf": [
              {
                "enum": [
                  "latest_available",
                  "earliest_available",
                  "original_only"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Required; explicit version selection (no default)",
            "title": "Version Policy"
          }
        },
        "required": [
          "ticker"
        ],
        "title": "ComputeRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "半導體產業官方財報自動抓取、持久化、財務指標計算、子產業版本化規則分析與前端快照 API。本服務不提供投資建議。",
    "title": "FinTrust Alert Financial Rule Engine API",
    "version": "0.3.0"
  },
  "openapi": "3.1.0",
